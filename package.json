		"@types/tinycolor2": "^1.4.6",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.1",
		"kleur": "^4.1.5",
		"nodemailer": "^10.0.0",
		"sass": "^1.104.0",
		"svelte-radix": "^3.0.2",
		"sveltekit-i18n": "^3.0.0",
		"tailwind-merge": "^3.6.0",
